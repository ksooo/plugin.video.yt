# settings category
msgctxt "#30000"
msgid "Account"
msgstr "Konto"

# settings label
msgctxt "#30010"
msgid "API key"
msgstr "API-Schlüssel"

# settings help
msgctxt "#30011"
msgid "Key for the YouTube Data API from your own Google Cloud project."
msgstr "Schlüssel für die YouTube Data API aus dem eigenen Google-Cloud-Projekt."

# settings label
msgctxt "#30012"
msgid "Client ID"
msgstr "Client-ID"

# settings help
msgctxt "#30013"
msgid "ID of the OAuth client of the type \"TVs and Limited Input devices\" from your own Google Cloud project."
msgstr "ID des OAuth-Clients vom Typ „TVs and Limited Input devices“ aus dem eigenen Google-Cloud-Projekt."

# settings label
msgctxt "#30014"
msgid "Client secret"
msgstr "Client-Secret"

# settings help
msgctxt "#30015"
msgid "Secret of that OAuth client."
msgstr "Secret dieses OAuth-Clients."

# settings label
msgctxt "#30016"
msgid "Sign in"
msgstr "Anmelden"

# settings help
msgctxt "#30017"
msgid "Sign in to YouTube on another device with a code. Needs client ID and client secret."
msgstr "Mit einem Code auf einem anderen Gerät bei YouTube anmelden. Setzt Client-ID und Client-Secret voraus."

# settings label
msgctxt "#30018"
msgid "Sign out"
msgstr "Abmelden"

# settings help
msgctxt "#30019"
msgid "Sign out of YouTube and revoke the add-on's access to the account."
msgstr "Bei YouTube abmelden und den Zugriff des Addons auf das Konto widerrufen."

# notification, YouTube gave no reason
msgctxt "#30100"
msgid "This video cannot be played."
msgstr "Dieses Video kann nicht wiedergegeben werden."

# notification
msgctxt "#30101"
msgid "YouTube cannot be reached."
msgstr "YouTube ist nicht erreichbar."

# notification
msgctxt "#30102"
msgid "This video can only be played when signed in."
msgstr "Dieses Video lässt sich nur mit Anmeldung wiedergeben."

# notification
msgctxt "#30103"
msgid "YouTube refused the request."
msgstr "YouTube hat die Anfrage abgelehnt."

# notification
msgctxt "#30104"
msgid "The daily quota of the YouTube Data API is used up."
msgstr "Das Tageskontingent der YouTube Data API ist aufgebraucht."

# notification
msgctxt "#30105"
msgid "This needs signing in."
msgstr "Dafür ist eine Anmeldung nötig."

# notification
msgctxt "#30106"
msgid "This needs an API key."
msgstr "Dafür ist ein API-Schlüssel nötig."

# notification, a search found no video
msgctxt "#30107"
msgid "Nothing found."
msgstr "Nichts gefunden."

# sign-in dialogue heading, {0} = step, {1} = number of steps
msgctxt "#30110"
msgid "Sign in ({0} of {1})"
msgstr "Anmelden ({0} von {1})"

# sign-in dialogue, {0} = web address, {1} = code
msgctxt "#30111"
msgid "On a phone or computer, go to [B]{0}[/B] and enter the code [B]{1}[/B]."
msgstr "Auf einem Smartphone oder Computer [B]{0}[/B] öffnen und den Code [B]{1}[/B] eingeben."

# sign-in dialogue, purpose of step 1
msgctxt "#30112"
msgid "This grants access to your subscriptions."
msgstr "Damit erhält das Addon Zugriff auf die Abos."

# sign-in dialogue, purpose of step 2
msgctxt "#30113"
msgid "This grants YouTube's app for Meta Quest access, which fetches recommendations and history and plays age-restricted videos."
msgstr "Damit erhält die YouTube-App für Meta Quest Zugriff, über die Empfehlungen und Verlauf abgerufen und altersbeschränkte Videos wiedergegeben werden."

# sign-in dialogue, while the code is requested
msgctxt "#30114"
msgid "Requesting a code…"
msgstr "Code wird abgerufen …"

# notification
msgctxt "#30120"
msgid "Signed in"
msgstr "Angemeldet"

# notification
msgctxt "#30121"
msgid "Signed out"
msgstr "Abgemeldet"

# notification
msgctxt "#30122"
msgid "Sign-in failed"
msgstr "Anmeldung fehlgeschlagen"

# notification
msgctxt "#30123"
msgid "The sign-in is no longer valid. Please sign in again."
msgstr "Die Anmeldung ist nicht mehr gültig. Eine erneute Anmeldung ist nötig."

# main menu
msgctxt "#30200"
msgid "Subscriptions"
msgstr "Abos"

# context menu of a video, {0} = channel
msgctxt "#30201"
msgid "Subscribe to channel {0}"
msgstr "Kanal {0} abonnieren"

# context menu of a video, {0} = channel
msgctxt "#30202"
msgid "Unsubscribe from channel {0}"
msgstr "Abo von Kanal {0} beenden"

# context menu of a channel
msgctxt "#30203"
msgid "Unsubscribe"
msgstr "Abo beenden"

# context menu of a video, {0} = channel
msgctxt "#30204"
msgid "Go to channel {0}"
msgstr "Zu Kanal {0} gehen"

# notification, {0} = channel
msgctxt "#30210"
msgid "Subscribed to channel {0}"
msgstr "Kanal {0} abonniert"

# notification, {0} = channel
msgctxt "#30211"
msgid "Unsubscribed from channel {0}"
msgstr "Abo von Kanal {0} beendet"

# confirmation, {0} = channel
msgctxt "#30212"
msgid "Unsubscribe from channel {0}?"
msgstr "Abo von Kanal {0} beenden?"

# main menu
msgctxt "#30300"
msgid "Trending"
msgstr "Trends"

# main menu, also heading of the search keyboard
msgctxt "#30301"
msgid "Search"
msgstr "Suche"

# folder below search
msgctxt "#30302"
msgid "Recent searches"
msgstr "Letzte Suchen"

# entry below search
msgctxt "#30303"
msgid "New search…"
msgstr "Neue Suche …"

# context menu of a recent search
msgctxt "#30304"
msgid "Delete"
msgstr "Löschen"

# confirmation
msgctxt "#30305"
msgid "Delete this search?"
msgstr "Diese Suche löschen?"

# main menu
msgctxt "#30400"
msgid "Recommendations"
msgstr "Empfehlungen"

# main menu
msgctxt "#30401"
msgid "History"
msgstr "Verlauf"
